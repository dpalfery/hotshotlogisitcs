{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug React Native (Expo)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--dev-client"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach to Packager",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 8081,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
